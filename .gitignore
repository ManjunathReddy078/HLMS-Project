# 1. Ignore everything in the root directory by default
/*

# 2. Whitelist ONLY the files and folders we want to push
!/Code/
!/README.md
!/.gitignore

# 3. Globally ignore massive build folders and private environment files inside the Code folder
node_modules/
.expo/
dist/
build/
.env
.env.*
.env.local
*.log
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
